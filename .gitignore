# Dependencies
node_modules/

# Build outputs
web/dist-driver/
web/dist-owner/
web/dist/

# Android build outputs (keep source, ignore compiled)
web/android/.gradle/
web/android/app/build/
web/android/build/
web/android/.idea/
web/android/local.properties
*.apk
*.aab

# Capacitor runtime (regenerated by cap sync)
