web/android/app/src/main/assets/capacitor.plugins.json

# Environment files (mode is set by build scripts, not env files)
.env
.env.*

# Server has its own git history — add separately after removing server/.git
server/

# OS / editor
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Temporary / cache
*.tmp
*.temp
